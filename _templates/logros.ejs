```{=html}
<div class="list timeline">
<% for (const item of items) { %>
  <div class="timeline-item" <%= metadataAttrs(item) %>>
    <div class="timeline-date listing-date"><%= item.date %></div>
    <div class="timeline-content">
      <div class="timeline-title listing-title">
        <%= item.title %>
        <% if (item.marca) { %><span class="timeline-mark"><%= item.marca %></span><% } %>
      </div>
      <% if (item.categories) { %>
        <div class="listing-categories">
          <% for (const cat of item.categories) { %>
            <div class="listing-category" onclick="window.quartoListingCategory('<%= utils.b64encode(cat) %>'); return false;"><%= cat %></div>
          <% } %>
        </div>
      <% } %>
      <% if (item.description) { %><p class="timeline-desc"><%= item.description %></p><% } %>
      <% if (item.image) { %><img class="timeline-img" src="<%- item.image %>" alt="<%= item.title %>" loading="lazy"><% } %>
    </div>
  </div>
<% } %>
</div>
```
