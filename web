#!/usr/bin/env python3
"""Herramienta para gestionar la web desde la terminal.

  ./web ver                         abre la vista previa en el navegador
  ./web nota "Título"               crea una nota nueva
  ./web aventura "Título"           crea una aventura nueva (con su carpeta de fotos)
  ./web fotos <carpeta>             prepara las fotos de una aventura (quita GPS, optimiza)
  ./web proyecto "Nombre"           crea un proyecto en "Sobre mí"
  ./web libro                       añade un libro a la Biblioteca (pregunta los datos)
  ./web editar <qué>                abre un archivo de datos: trayectoria, formacion,
                                    publicaciones, idiomas, reconocimientos, libros
  ./web comprobar                   compila la web entera para ver que no hay errores
  ./web publicar ["mensaje"]        guarda los cambios y los sube: la web se publica sola

Ejecuta ./web <orden> --help para ver las opciones de cada orden.
"""
import argparse
import datetime as dt
import os
import shutil
import subprocess
import sys
import unicodedata
import urllib.parse
import urllib.request
import json
from pathlib import Path

RAIZ = Path(__file__).resolve().parent
HOY = dt.date.today()

DATOS = {
    "trayectoria": "sobre-mi/datos/trayectoria.yml",
    "formacion": "sobre-mi/datos/formacion.yml",
    "publicaciones": "sobre-mi/datos/publicaciones.yml",
    "idiomas": "sobre-mi/datos/idiomas.yml",
    "reconocimientos": "sobre-mi/datos/reconocimientos.yml",
    "libros": "biblioteca/datos/libros.yml",
}


# ---------------------------------------------------------------- utilidades

def slug(texto):
    """"Mi primera nota!" → "mi-primera-nota" (sin tildes ni símbolos)."""
    t = unicodedata.normalize("NFKD", texto).encode("ascii", "ignore").decode().lower()
    return "-".join("".join(c if c.isalnum() else " " for c in t).split()) or "sin-titulo"


def comillas(texto):
    return '"' + texto.replace("\\", "\\\\").replace('"', '\\"') + '"'


def carpeta_fechada(seccion, titulo):
    """<sección>/<año>/<mes>-<nombre>/ ; falla si ya existe."""
    carpeta = RAIZ / seccion / f"{HOY:%Y}" / f"{HOY:%m}-{slug(titulo)}"
    if carpeta.exists():
        sys.exit(f"Ya existe {carpeta.relative_to(RAIZ)}/")
    return carpeta


def abrir(ruta):
    """Abre el archivo en VS Code (o en $EDITOR) si está disponible."""
    editor = "code" if shutil.which("code") else os.environ.get("EDITOR")
    if editor:
        subprocess.run([editor, str(ruta)])


def preview_activa():
    return subprocess.run(["pgrep", "-f", "[q]uarto.js preview"], capture_output=True).returncode == 0


def creado(ruta, siguiente):
    print(f"✔ Creado {ruta.relative_to(RAIZ)}")
    print(f"  Siguiente: {siguiente}")
    abrir(ruta)


# ---------------------------------------------------------------- órdenes

def ver(_):
    os.chdir(RAIZ)
    os.execvp("quarto", ["quarto", "preview"])


