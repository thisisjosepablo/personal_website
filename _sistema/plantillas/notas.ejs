```{=html}
<div class="list notas-lista">
<% for (const item of items) { %>
  <article class="nota" <%= metadataAttrs(item) %>>
    <div class="nota-fecha listing-date"><%= item.date %></div>
    <div class="nota-cuerpo">
      <h3 class="nota-titulo listing-title"><a href="<%- item.path %>"><%= item.title %></a></h3>
      <% if (item.description) { %>
        <p class="nota-resumen listing-description"><%= item.description %></p>
      <% } %>
      <% if (item.categories && item.categories.length) { %>
        <div class="nota-etiquetas listing-categories">
          <% for (const cat of item.categories) { %>
            <a class="nota-etiqueta listing-category" href="#" onclick="window.quartoListingCategory('<%= utils.b64encode(cat) %>'); return false;"><%= cat %></a>
          <% } %>
        </div>
      <% } %>
    </div>
  </article>
<% } %>
</div>
```
